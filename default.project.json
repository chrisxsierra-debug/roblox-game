          "Glare": 0.25,
          "Haze": 0.35
        }
      },
      "StormColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.05,
          "Contrast": 0.14,
          "Saturation": -0.15,
          "TintColor": [ 0.94, 0.96, 1.0 ]
        }
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}